# Cloudflare credentials for deploying from your own machine.
# Copy this file to .env and fill both values in. Never commit .env.
#
#   cp .env.example .env
#
# Used by `npm run deploy:cloudflare` (needs Node 22) and by
# `npm run deploy:docker` (builds and deploys inside a Node 22 container).
# GitHub Actions does not read this file; it uses repository secrets of the
# same names, under Settings > Secrets and variables > Actions.

# Create one from the "Edit Cloudflare Workers" template at
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Shown on the Workers & Pages overview in the Cloudflare dashboard.
CLOUDFLARE_ACCOUNT_ID=
